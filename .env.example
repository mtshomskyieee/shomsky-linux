# Copy to .env and adjust. Used by docker compose.

# Disable Compose helper menu so `up` doesn't steal keystrokes
COMPOSE_MENU=false

# Image tag (built locally by default)
SHOMSKY_IMAGE=shomskylinux:dev

# Model alias from /etc/engram/models.toml (or run ./choose_llm.sh):
#   mistral (default) | qwen | qwen1.5 | qwen3 | qwen-coder
#   deepseek | llama | gemma | phi | tiny
# Use tiny on machines with <8GB free RAM.
SHOMSKY_MODEL=mistral

# agent | hallucination | root
ENGRAM_MODE=agent

# auto | native | text  (tiny models work best with text)
ENGRAM_TOOL_STYLE=auto

# Spinner while waiting on LLM/tools (auto = TTY only; always|off)
# ENGRAM_SPINNER=auto

# Startup model readiness wait (seconds; interactive shell only)
# ENGRAM_LLM_READY_TRIES=600

# Keep context small for CPU hosts
ENGRAM_MAX_CONTEXT=24

# Build knobs
CARGO_BUILD_JOBS=2
# ALPINE_VERSION=3.24
# MISTRALRS_REF=v0.9.0

# Memory limits for the compose service
SHOMSKY_MEM_LIMIT=8g
SHOMSKY_SHM_SIZE=1gb

# Host path bind-mounted to /engram/user (agent/root start directory).
# First ./start-shomsky-linux-shell.sh asks: your home, or ./engram/user.
# Hallucination mode ignores this and stays on its virtual filesystem.
# SHOMSKY_USER_DIR=./engram/user
# home | engram — prompt label; omitted means engram
# SHOMSKY_WORKDIR_KIND=engram

# Host path bind-mounted to /engram/.hallucination_shell_history
# SHOMSKY_HALLUC_HISTORY=./.hallucination_shell_history

# Optional Hugging Face token
# HF_TOKEN=
